# Po izbiri domene zamenjaj sola.example.org in priklopi prave certifikate.
server {
    listen 80;
    server_name sola.example.org;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name sola.example.org;
    ssl_certificate /etc/letsencrypt/live/sola.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sola.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 12m;
    location / {
        proxy_pass http://aplikacija:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 120s;
    }
}
